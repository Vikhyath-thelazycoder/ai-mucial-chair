# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase production project (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase test project (tests and scripts/simulate.ts only)
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-only)
GEMINI_API_KEY=
# GEMINI_MODEL (optional): pin a model. Unset = gemini-flash-latest, which always tracks the current Flash model.

# Spotify developer app Client ID
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
